  "critical_findings": [
    {
      "id": "SEC-01",
      "severity": "CRITICAL",
      "category": "Security / Authorization",
      "title": "RLS Privilege Escalation on public.users",
      "remediation": "Split into separate SELECT and UPDATE policies; disallow updating role_id."
    },
    {
      "id": "SEC-02",
      "severity": "CRITICAL",
      "category": "Security / Data Privacy",
      "title": "Plaintext Password Storage in public.users.password and UI Viewer Cell",
      "remediation": "Drop password column from public.users; eliminate eye-toggle viewer; rely solely on GoTrue hashes."
    },
    {
      "id": "SEC-03",
      "severity": "HIGH",
      "category": "Security / Secrets Exposure",
      "title": "Client-Exposed Sarvam AI Secret API Key in VITE_SARVAM_API_KEY",
      "remediation": "Proxy speech synthesis requests through a secure Supabase Edge Function."
    },
    {
      "id": "ARC-01",
      "severity": "HIGH",
      "category": "Architecture / Integrity",
      "title": "Non-Atomic Sequential STU Onboarding Wizard with Pseudo-Rollback",
      "remediation": "Encapsulate organization, region, depot, and user creation inside a single atomic PostgreSQL transaction."
    },
    {
      "id": "TST-01",
      "severity": "HIGH",
      "category": "Quality Assurance",
      "title": "Zero Automated Tests (0% Unit/Integration/E2E Coverage)",
      "remediation": "Implement Vitest unit test suite and Playwright E2E test matrix meeting Gate 6 acceptance criteria."
    }
  ],
